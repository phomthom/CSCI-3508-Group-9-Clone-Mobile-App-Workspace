# Deployment runtime settings only. Never use these as Docker build arguments.
NODE_ENV=production
PORT=8080
SE_BACKEND_URL=https://studentexchangebck-fpdnfpcqe4bje2eh.westus-01.azurewebsites.net/
SE_PUBLIC_ORIGIN=https://your-adapter.example.com
# Supply the actual value through hosting secret storage, not this template.
SE_APP_ACCESS=replace-in-secret-manager
# Leave false until backend requests have been explicitly authorized.
SE_ENABLE_BACKEND_TRAFFIC=false
WEB_CONCURRENCY=1
SE_SESSION_STORE=memory
SE_UPSTREAM_TIMEOUT_MS=180000
SE_REQUESTS_PER_MINUTE=300
SE_AUTH_REQUESTS_PER_MINUTE=20
SE_MAX_CONCURRENT_REQUESTS=4
